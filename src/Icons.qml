    readonly property url volume1Stroked: "qrc:/qt/qml/Semi/icons/volume_1_stroked.svg"
    readonly property url volume2: "qrc:/qt/qml/Semi/icons/volume_2.svg"
    readonly property url volume2Stroked: "qrc:/qt/qml/Semi/icons/volume_2_stroked.svg"
    readonly property url volumeSilentStroked: "qrc:/qt/qml/Semi/icons/volume_silent_stroked.svg"
    readonly property url volumnSilent: "qrc:/qt/qml/Semi/icons/volumn_silent.svg"
    readonly property url voteStroked: "qrc:/qt/qml/Semi/icons/vote_stroked.svg"
    readonly property url voteVideoStroked: "qrc:/qt/qml/Semi/icons/vote_video_stroked.svg"
    readonly property url weibo: "qrc:/qt/qml/Semi/icons/weibo.svg"
    readonly property url wholeWord: "qrc:/qt/qml/Semi/icons/whole_word.svg"
    readonly property url wifi: "qrc:/qt/qml/Semi/icons/wifi.svg"
    readonly property url windowAdaptionStroked: "qrc:/qt/qml/Semi/icons/window_adaption_stroked.svg"
    readonly property url word: "qrc:/qt/qml/Semi/icons/word.svg"
    readonly property url wrench: "qrc:/qt/qml/Semi/icons/wrench.svg"
    readonly property url wrenchStroked: "qrc:/qt/qml/Semi/icons/wrench_stroked.svg"
    readonly property url xiguaLogo: "qrc:/qt/qml/Semi/icons/xigua_logo.svg"
    readonly property url youtube: "qrc:/qt/qml/Semi/icons/youtube.svg"

    // 按图标名取 URL：snake_case（文件名那套）与 camelCase（属性那套）都认。
    // 名字不在清单里返回空串，而不是回一个读不到的 URL。
    function resolve(name: string): url {
        const key = root._key(name)
        if (key === "" || !(key in root))
            return ""
        const value = String(root[key])
        // 认前缀再放行的原因：objectName / resolve 这类自带成员也过得了 `in`，
        // 但它们不是图标 URL —— 名字撞上了照样该回空。
        return value.indexOf("qrc:/qt/qml/Semi/icons/") === 0 ? value : ""
    }

    // 图标名 -> 属性名：连字符当下划线、段首大写、撞 Qt 保留名的加 Icon 后缀。
    // 与 scripts/gen-icons.py 的 camelize() 同一条规则，改名表由生成器烘进来，两处不会分家。
    function _key(name: string): string {
        const renamed = {
            "delete": "deleteIcon",
            "export": "exportIcon",
            "import": "importIcon",
            "print": "printIcon",
        }
        const parts = String(name).replace(/-/g, "_").split("_")
        let key = ""
        for (let i = 0; i < parts.length; ++i)
            key += i === 0 ? parts[i] : parts[i].charAt(0).toUpperCase() + parts[i].slice(1)
        return renamed[key] !== undefined ? renamed[key] : key
    }
}
